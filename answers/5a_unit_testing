"""Unit tests for the EmotionDetection.emotion_detection module."""
import unittest

from EmotionDetection.emotion_detection import emotion_detector


class TestEmotionDetection(unittest.TestCase):
    """Verify dominant emotions detected for the required statements."""

    def check_dominant_emotion(self, statement, expected):
        """Assert the expected dominant emotion and valid emotion scores."""
        result = emotion_detector(statement)
        self.assertEqual(result["dominant_emotion"], expected)
        for emotion in ("anger", "disgust", "fear", "joy", "sadness"):
            self.assertIsInstance(result[emotion], (int, float))
            self.assertGreaterEqual(result[emotion], 0.0)

    def test_joy(self):
        """A glad statement is dominated by joy."""
        self.check_dominant_emotion("I am glad this happened", "joy")

    def test_anger(self):
        """A mad statement is dominated by anger."""
        self.check_dominant_emotion("I am really mad about this", "anger")

    def test_disgust(self):
        """A disgusted statement is dominated by disgust."""
        self.check_dominant_emotion(
            "I feel disgusted just hearing about this", "disgust")

    def test_fear(self):
        """An afraid statement is dominated by fear."""
        self.check_dominant_emotion(
            "I am really afraid that this will happen", "fear")

    def test_sadness(self):
        """A sad statement is dominated by sadness."""
        self.check_dominant_emotion("I am so sad about this", "sadness")


if __name__ == "__main__":
    unittest.main()
